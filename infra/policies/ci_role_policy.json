{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ArtifactAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::@BUCKET@", "arn:aws:s3:::@BUCKET@/*"]
    },
    {
      "Sid": "LambdaMicrovmsControlPlane",
      "Effect": "Allow",
      "Action": [
        "lambda:GetMicrovm",
        "lambda:ListMicrovms",
        "lambda:RunMicrovm",
        "lambda:TerminateMicrovm",
        "lambda:CreateMicrovmAuthToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassNetworkConnector",
      "Effect": "Allow",
      "Action": ["lambda:PassNetworkConnector"],
      "Resource": "*"
    },
    {
      "Sid": "PassDenyOnlyExecutionRole",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::@ACCOUNT@:role/k344-prci-execution-role",
      "Condition": {
        "StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"}
      }
    },
    {
      "Sid": "ReadBuildLogs",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups", "logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents"],
      "Resource": "arn:aws:logs:ap-northeast-1:@ACCOUNT@:*"
    },
    {
      "Sid": "ExplicitDenyDangerousAdminActions",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:CreateUser",
        "iam:CreateRole",
        "iam:PutUserPolicy",
        "iam:PutRolePolicy",
        "iam:AttachUserPolicy",
        "iam:AttachRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:CreatePolicyVersion",
        "organizations:*",
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail"
      ],
      "Resource": "*"
    }
  ]
}
