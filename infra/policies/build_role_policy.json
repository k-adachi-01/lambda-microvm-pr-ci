{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadArtifact",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::@BUCKET@/*"]
    },
    {
      "Sid": "BuildLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": ["arn:aws:logs:ap-northeast-1:@ACCOUNT@:*"]
    }
  ]
}
